     1                                  org 0x7e00
     2 00000000 E98000                    jmp start
     3 00000003 4A                        db 'J' ; is for testing as it will show up at 0x7e04 since long jump
     4                                    %include "print.inc"
     1                              <1> do_char:
     2 00000004 E81B00              <1>   call cprint ; print a character and then go back to sprint
     3                              <1> sprint: 
     4 00000007 AC                  <1>   lodsb ; puts the current character pointed to by si into al then increments si to point to the next character in the string
     5 00000008 3C00                <1>   cmp al, 0 ; check for end of string
     6 0000000A 75F8                <1>   jne do_char ; if not end of string print the character and go back to the start of sprint
     7 0000000C 8006[6B00]01        <1>   add byte [ypos], 1 ; end of string so move on to the next line
     8 00000011 C606[6A00]00        <1>   mov byte [xpos], 0 ; and reset to the start of the line
     9 00000016 31C0                <1>   xor ax, ax ; set ax to 0 for es
    10 00000018 8EC0                <1>   mov es, ax ; set es to 0 so other stuff dont break or something
    11 0000001A C3                  <1>   ret
    12                              <1> 
    13                              <1> print:
    14 0000001B B800B8              <1>   mov ax, 0xb800 ; 0xb800 into ax for es
    15 0000001E 8EC0                <1>   mov es, ax ; 0xb800 into es as that is what lets us print stuff
    16 00000020 EBE5                <1>   jmp sprint ; now we can start actually printing stuff
    17                              <1> 
    18                              <1> cprint:
    19 00000022 B40D                <1>   mov ah,0x0D ; tell the magic screen to print in a certain format (green on black) also known as the attribute
    20 00000024 89C1                <1>   mov cx,ax ; save the character and attribute (ax) temporarily in cx
    21 00000026 0FB606[6B00]        <1>   movzx ax, byte [ypos] ; store the y position in al (second byte of ax) and 0s for ah
    22 0000002B BAA000              <1>   mov dx, 160 ; store 160 in dx (each character has 2 bytes(the character and its attribute) and each row has 80 characters, multiply to find most of offset)
    23 0000002E F7E2                <1>   mul dx ; multiply dx by ax and store in ax (only works for low enough ax but max for this is 80 which is fine otherwise it overflows into dx)
    24 00000030 0FB61E[6A00]        <1>   movzx bx, byte [xpos] ; store the x position in bl (second byte of bx) and 0s for bh
    25 00000035 D1E3                <1>   shl bx, 1 ; left shift b by 1 (times 2), this adds the final bit of offset for the video memory for the column
    26                              <1>   
    27 00000037 BF0000              <1>   mov di, 0 ; set the offset to 0
    28 0000003A 01C7                <1>   add di, ax ; add row offset to di
    29 0000003C 01DF                <1>   add di, bx ; add column offset to di, di now points to the place on screen to display the charcater
    30                              <1> 
    31 0000003E 89C8                <1>   mov ax,cx ; get the character and attribute cx back into ax ready for printing
    32 00000040 AB                  <1>   stosw ; copy ax to es:di which currently points to the position in the video memory for printing the character
    33 00000041 8006[6A00]01        <1>   add byte [xpos], 1 ; increment xpos so it points at the next position to print to
    34                              <1> 
    35 00000046 C3                  <1>   ret
    36                              <1> 
    37                              <1> print_reg16:
    38 00000047 BF[7C00]            <1>   mov di, outstr16 ; points di to the start of outstr16 to go through and update with the correct values
    39 0000004A A1[8100]            <1>   mov ax, [reg16] ; puts the contents of reg16 into ax
    40 0000004D BE[6C00]            <1>   mov si, hexstr ; changes si to point to the start of hexstr
    41 00000050 B90400              <1>   mov cx, 4 ; puts 4 in cx, acting as a count controlled loop
    42                              <1> hexloop:
    43 00000053 C1C004              <1>   rol ax, 4 ; cicular left shift of ax 4 places moving leftmost 4 bits to the rightmost 4 bits
    44 00000056 89C3                <1>   mov bx, ax; copy ax into bx to preserve ax for the next loop
    45 00000058 83E30F              <1>   and bx, 0x0f, ; clears upper 12 bits and leaves lower 4 bits resulting in bx storing the rightmost 4 bits of ax which is the leftmost of video mem 1
    46 0000005B 8A18                <1>   mov bl, [si+bx] ; changes bl to be the value of the hex lookup + offset so it points to the correct character representing the 4 bits
    47 0000005D 881D                <1>   mov [di], bl ; change the char pointed to by di which is in the outstr16 to the correct char which is in bl
    48 0000005F 47                  <1>   inc di ; move to the next char in outstr16
    49 00000060 49                  <1>   dec cx ; only needs to happen 4 times
    50 00000061 75F0                <1>   jnz hexloop ; loop back if not finished
    51                              <1> 
    52 00000063 BE[7C00]            <1>   mov si, outstr16 ; once outstr16 contains the data in string hex format, put it in si ready for printing
    53 00000066 E8B2FF              <1>   call print ; print outstr16
    54                              <1> 
    55 00000069 C3                  <1>   ret
    56                              <1> 
    57                              <1> 
    58 0000006A 00                  <1>   xpos db 0 ; position along the rows for the video memory
    59 0000006B 00                  <1>   ypos db 0 ; how many rows down for video memory
    60 0000006C 303132333435363738- <1>   hexstr db '0123456789ABCDEF'
    60 00000075 39414243444546      <1>
    61 0000007C 3030303000          <1>   outstr16 db '0000', 0 ; empty initialised string to print the first character in hex
    62 00000081 0000                <1>   reg16 dw 0 ; initialise 2 bytes for reg16
